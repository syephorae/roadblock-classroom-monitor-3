rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function newTeacherStudentLinkIsOwned() {
      return request.resource.data.teacherId == request.auth.uid;
    }

    match /teachers/{teacherId} {
      allow get: if isOwner(teacherId);
      allow list: if false;
      allow create: if isOwner(teacherId) && request.resource.data.id == teacherId;
      allow update: if isExistingOwner(teacherId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(teacherId);

      match /students/{studentId}/records/{recordId} {
        allow get: if isOwner(teacherId);
        allow list: if isOwner(teacherId);
        allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId;
        allow update: if isExistingOwner(teacherId) && request.resource.data.studentId == resource.data.studentId;
        allow delete: if isExistingOwner(teacherId);
      }
    }
    
    match /classes/{classId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() || request.auth == null;
      allow update: if request.auth == null;
      allow delete: if false;
    }

    match /teacher_students/{teacherStudentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && newTeacherStudentLinkIsOwned();
      allow update: if false;
      allow delete: if resource != null && isOwner(resource.data.teacherId);
    }

    match /schools/{schoolId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}
